		<add key="DBTableModel" value="E:\\TEMS\\Development\\Sandhata\\FeedBackLoop\\Model\\DBTable.mapping"/> 

		<!-- Linux Config-->
		<!--<add key="SFTP_path" value="/home/camadm/output/"/>
